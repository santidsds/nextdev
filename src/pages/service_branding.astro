---
import Layout from "../layouts/Layout.astro";
import backBtn from "../assets/btn_back.svg?url"
import ham from "../assets/btn_ham.svg?url"
import ContactForm from "../components/ContactForm.astro";

---

<Layout title="Identidad visual y branding" >

	<div class="h-screen w-screen bg-secondary_bg bg-cover overflow-auto overflow-x-hidden scroll-container" >
        <div class="w-full flex justify-between px-48 mt-4 fixed opacity-90 z-50">
            <button class=""><a class="p-3" href="/#services"><img src={backBtn} alt="Back to services"></a></button>
            <h1 id="sectionTitle" class="mt-4 drop-shadow-xl shadow-black text-center text-purple-200 font-bold text-xl tracking-widest">IDENTIDAD VISUAL Y BRANDING</h1>
            <button class="opacity-0"><img src={ham} alt="Menu"></button>
        </div>

        <div id="sectionDots" class="fixed left-6 top-1/2 -translate-y-1/2 flex flex-col gap-3 z-50">
            <button class="dot active" data-target="firstScrolleable" aria-label="Ir a seccion 1"></button>
            <button class="dot" data-target="secondScrolleable" aria-label="Ir a seccion 2"></button>
            <button class="dot" data-target="thirdScrolleable" aria-label="Ir a seccion 3"></button>
        </div>

        <div id="smoothContainer" class="flex justify-start items-start pt-[10em] px-48 ">
            <div class=" h-[200vh] z-30">
                <div class="scroller pt-[15em]">
                    <div id="firstScrolleable" class="font-black text-light_gray snap-child">
                        <div class="text-white font-black tracking-widest text-3xl  ">
                            <h1 class="multicolor">DEFINE TU MARCA</h1>
                        
                        </div>
                        <div class="opacity-80">
                            <p class="font-bold text-xl max-w-2xl mt-[1em] text-white ">Creamos identidad visual coherente: logo, paleta y estilo que reflejan tu esencia.</p>
                            <p class="font-bold text-xl max-w-2xl mt-[1em] text-white ">Aplicamos la marca a tu web, presentaciones y redes para que todo hable el mismo lenguaje.</p>
                        </div>
                    
                    </div> 
                    <div id="secondScrolleable" class="font-black text-light_gray mt-52 snap-child ">
                        <div class="text-white font-black tracking-widest text-3xl  ">
                            <h1 class="multicolor">CONSISTENCIA EN TODOS LOS CANALES</h1>
                        
                        </div>
                        <div class="opacity-80">
                            <p class="font-semibold text-md max-w-2xl mt-[1em] text-white ">Guías de estilo claras para que tu equipo y partners mantengan la misma estética y tono.</p>
                            <p class="font-semibold text-md max-w-2xl mt-[1em] text-white ">Desde landing hasta redes: una experiencia visual sólida y memorable.</p>
                        </div>
                    
                    </div> 
                    <div id="thirdScrolleable" class=" font-black text-light_gray mt-52 snap-child">
                        <div class="text-white font-black tracking-widest text-3xl  ">
                            <h1 class="multicolor">ENTREGABLES LISTOS</h1>
                        
                        </div>
                        <div class="opacity-80">
                            <p class="font-bold text-xl max-w-2xl mt-[1em] text-white ">Kit completo de marca, assets optimizados y plantillas listas para publicar.</p>
                            <p class="font-bold text-xl max-w-2xl mt-[1em] text-white ">Acompañamos en el rollout para que tu nueva identidad tenga impacto inmediato.</p>
                        </div>
                    
                    </div> 
                </div>
            </div>
            
            <div id="videoDiv" class="fixed right-0 mt-[-8em] transition-all ease-in-out duration-200">
                <div data-us-project="Sg8WpYHGFTowEnfHTQxl" style="width:1080px; height: 1080px;"></div>
            </div>
        </div>
        
        
        <div class=" flex justify-between items-start w-full z-30 pt-0 snap-child ">
            
            <div id="fourthScrolleable" class="sticky top-[45%] left-[10%]">
                <h1 class=" text-light_gray font-[700] text-4xl max-w-xl">
                    Obtene tu presupuesto<span class="text-white"> personalizado</span> y una identidad visual <span class="text-white">lista para crecer</span>
                </h1>
            </div> 
            
            <div id="fifthScrolleable" class="mt-[-15em] mr-20 mb-20">
                <ContactForm/>
            </div>  
        </div>
	</div>
</Layout>

<style>
    .scroll-container {
        scroll-snap-type: y proximity;
        overflow-y: scroll;
        height: 100vh;
        -webkit-overflow-scrolling: touch;
    }

    .snap-child {
        scroll-snap-align: center;
    }

    #firstScrolleable,
    #secondScrolleable,
    #thirdScrolleable {
        transition: opacity 0.3s ease;
        will-change: opacity;
        opacity: 0;
    }

    #fifthScrolleable {
        transition: opacity 0.3s ease;
        will-change: opacity;
        opacity: 0;
        
    }

    #sectionTitle {
        transition: opacity 0.5s ease-in-out, transform 0.4s ease-in-out;
        will-change: opacity, transform;
        opacity: 0;
        transform: translateY(-100px);
    }

    #videoDiv {
        transition: opacity 0.2s ease-in;
        will-change: opacity;
    }

    #smoothContainer {
        scroll-behavior: smooth;
    }
@media (prefers-reduced-motion: reduce) {
        .scroll-container {
            scroll-behavior: auto;
        }
        
        #firstScrolleable,
        #secondScrolleable,
        #thirdScrolleable,
        #fourthScrolleable,
        #fifthScrolleable,
        #videoDiv {
            transition: none;
        }
    }
</style>

<script>
window.addEventListener('DOMContentLoaded', function() {
    const firstScrolleable = document.getElementById('firstScrolleable');
    const secondScrolleable = document.getElementById('secondScrolleable');
    const thirdScrolleable = document.getElementById('thirdScrolleable');
    const fourthScrolleable = document.getElementById('fourthScrolleable');
    const fifthScrolleable = document.getElementById('fifthScrolleable');
    const sectionTitle = this.document.getElementById('sectionTitle')
    const video = document.getElementById('videoDiv');
    const scrollContainer = document.querySelector('.scroll-container');
    const dots = Array.from(document.querySelectorAll('#sectionDots .dot')) as HTMLButtonElement[];

    if (!video) {
        console.warn('Video element not found');
        return;
    }

    if (firstScrolleable) {
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                requestAnimationFrame(() => {
                    if (entry.isIntersecting) {
                        firstScrolleable.style.opacity = '1';
                        video.style.opacity = '1';
                        sectionTitle.style.transform = 'translateY(0px)';
                    } else {
                        firstScrolleable.style.opacity = '0';
                    }
                });
            });
        }, {
            root: scrollContainer || null,
            threshold: 0.9,
            rootMargin: '-20% 0px -20% 0px'
        });
        observer.observe(firstScrolleable);
    }

    if (secondScrolleable) {
        const observer2 = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                requestAnimationFrame(() => {
                    if (entry.isIntersecting) {
                        secondScrolleable.style.opacity = '1';
                        video.style.opacity = '1';
                    } else {
                        secondScrolleable.style.opacity = '0';
                    }
                });
            });
        }, {
            root: scrollContainer || null,
            threshold: 0.9,
            rootMargin: '-20% 0px -20% 0px'
        });
        observer2.observe(secondScrolleable);
    }

    if (thirdScrolleable) {
        const observer3 = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                requestAnimationFrame(() => {
                    if (entry.isIntersecting) {
                        thirdScrolleable.style.opacity = '1';
                        video.style.opacity = '1';
                    } else {
                        thirdScrolleable.style.opacity = '0';
                    }
                });
            });
        }, {
            root: scrollContainer || null,
            threshold: 0.9,
            rootMargin: '-20% 0px -20% 0px'
        });
        observer3.observe(thirdScrolleable);
    }

    // Dot navigation sync
    const sectionMap = {
        firstScrolleable,
        secondScrolleable,
        thirdScrolleable,
    };

    const setActiveDot = (id: string | null) => {
        if (!id) return;
        dots.forEach((dot) => {
            const target = dot.dataset?.target;
            dot.classList.toggle('active', target === id);
        });
    };

    dots.forEach((dot) => {
        dot.addEventListener('click', () => {
            const targetId = dot.dataset?.target;
            const el = targetId ? sectionMap[targetId] : null;
            if (el) el.scrollIntoView({ behavior: 'smooth', block: 'center' });
        });
    });

    const updateActiveDot = () => {
        const containerRect = scrollContainer?.getBoundingClientRect() || { top: 0, height: window.innerHeight };
        const viewportCenter = containerRect.height / 2;
        let closestId = null;
        let closestDist = Infinity;

        Object.values(sectionMap).forEach((el) => {
            if (!el) return;
            const rect = el.getBoundingClientRect();
            const center = rect.top - containerRect.top + rect.height / 2;
            const dist = Math.abs(center - viewportCenter);
            if (dist < closestDist) {
                closestDist = dist;
                closestId = el.id;
            }
        });

        if (closestId) setActiveDot(closestId);
    };

    const handleDotScroll = () => {
        requestAnimationFrame(updateActiveDot);
    };

    if (scrollContainer) {
        scrollContainer.addEventListener('scroll', handleDotScroll, { passive: true });
        updateActiveDot();
    } else {
        window.addEventListener('scroll', handleDotScroll, { passive: true });
        updateActiveDot();
    }

    function isFourthScrolleableSticky() {
        if (!fourthScrolleable || !scrollContainer) return false;
        
        const fourthRect = fourthScrolleable.getBoundingClientRect();
        const containerRect = scrollContainer.getBoundingClientRect();
        const viewportHeight = containerRect.height;
        
        const stickyTopPosition = containerRect.top + (viewportHeight * 0.45);
        const distanceFromSticky = Math.abs(fourthRect.top - stickyTopPosition);
        const tolerance = 30;
        const isVisible = fourthRect.top >= containerRect.top && 
                         fourthRect.bottom <= containerRect.bottom;
        
        return distanceFromSticky <= tolerance && isVisible;
    }

    function showContactForm() {
        if (fifthScrolleable) {
            requestAnimationFrame(() => {
                fifthScrolleable.style.opacity = '1';
            });
        }
    }

    function hideContactForm() {
        if (fifthScrolleable) {
            requestAnimationFrame(() => {
                fifthScrolleable.style.opacity = '0';
            });
        }
    }

    if (fourthScrolleable) {
        const observer4 = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                requestAnimationFrame(() => {
                    if (entry.isIntersecting) {
                        video.style.opacity = '0';
                        sectionTitle.style.transform = 'translateY(-100px)';
                        sectionTitle.style.opacity = '0';
                    } else {
                        video.style.opacity = '1';
                        sectionTitle.style.transform = 'translateY(0px)';
                        sectionTitle.style.opacity = '1';
                    }
                });
            });
        }, {
            root: scrollContainer,
            threshold: 0.5,
            rootMargin: '0px'
        });
        observer4.observe(fourthScrolleable);
    }

    let scrollTicking = false;
    if (scrollContainer && fourthScrolleable) {
        scrollContainer.addEventListener('scroll', function() {
            if (!scrollTicking) {
                requestAnimationFrame(() => {
                    if (isFourthScrolleableSticky()) {
                        showContactForm();
                    } else {
                        hideContactForm();
                    }
                    scrollTicking = false;
                });
                scrollTicking = true;
            }
        });
    }

    const removeCredit = () => {
        document.querySelectorAll('a[href=\"https://unicorn.studio?utm_source=public-url\"]').forEach(el => el.remove());
    };

    removeCredit();

    const observer = new MutationObserver(() => removeCredit());
    observer.observe(document.body, { childList: true, subtree: true });
}); 
</script>
